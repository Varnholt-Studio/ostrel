// CallDepth (SPEC 12.4): main is frame 1, so down(9998) holds exactly 10 000 frames and
// runs; down(9999) needs frame 10 001, which the recursive call in down(1) would create.

fn down(n: Int)
  if n == 0
    return
  down(n - 1)

fn main()
  print("start")
  down(9998)
  print("10000 frames fit")
  down(9999)
  print("not reached")
