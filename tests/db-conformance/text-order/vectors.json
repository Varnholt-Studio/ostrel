    {
     "text": "\uD7FF"
    },
    {
     "text": "\uE000"
    },
    {
     "text": "\uFF01"
    },
    {
     "text": "\uFFFD"
    },
    {
     "text": "\uFFFF"
    },
    {
     "text": "\uD800\uDC00"
    },
    {
     "text": "\uD83D\uDE00"
    },
    {
     "text": "\uDBFF\uDFFF"
    }
   ]
  },
  {
   "name": "emoji_sequences",
   "doc": "Emoji sequences compare code point by code point, not as graphemes.",
   "sorted": [
    {
     "text": "\uD83C\uDDE9"
    },
    {
     "text": "\uD83C\uDDE9\uD83C\uDDEA"
    },
    {
     "text": "\uD83D\uDC68"
    },
    {
     "text": "\uD83D\uDC68\u200D"
    },
    {
     "text": "\uD83D\uDC68\u200D\uD83D\uDC69\u200D\uD83D\uDC67"
    },
    {
     "text": "\uD83D\uDE00"
    }
   ]
  },
  {
   "name": "combining_not_normalised",
   "doc": "e plus U+0301 is not U+00E9; nothing is normalised (NFC would make them equal).",
   "sorted": [
    {
     "text": "e"
    },
    {
     "text": "ez"
    },
    {
     "text": "e\u0301"
    },
    {
     "text": "\u00E9"
    }
   ]
  },
  {
   "name": "combining_mark_order",
   "doc": "Combining marks keep their stored order; U+0301 U+0323 and U+0323 U+0301 differ.",
   "sorted": [
    {
     "text": "a\u0301\u0323"
    },
    {
     "text": "a\u0323\u0301"
    }
   ]
  },
  {
   "name": "utf8_lengths_mixed",
   "doc": "One, two, three and four byte UTF-8 sequences in code point order.",
   "sorted": [
    {
     "text": "\u007F"
