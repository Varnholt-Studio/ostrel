{
 "format": 1,
 "ac": "AC-29",
 "doc": "Shared Text vectors: order by Unicode code point (ARCHITECTURE 6.2, D50), len in Unicode scalar values and inclusive ranges (SYNTAX 4.2, B-F14). Run by the conformance harness (T70), the VM (T2) and the JS runtime (T3).",
 "order": [
  {
   "name": "ascii_case",
   "doc": "Upper case before lower case; no locale folding.",
   "sorted": [
    {
     "text": "A"
    },
    {
     "text": "Z"
    },
    {
     "text": "a"
    },
    {
     "text": "z"
    }
   ]
  },
  {
   "name": "prefix_first",
   "doc": "A proper prefix sorts first; the empty text is smallest.",
   "sorted": [
    {
     "text": ""
    },
    {
     "text": "a"
    },
    {
     "text": "a\u0000"
    },
    {
     "text": "aa"
    },
    {
     "text": "ab"
    }
   ]
  },
  {
   "name": "nul_and_controls",
   "doc": "NUL and control characters are ordinary code points.",
   "sorted": [
    {
     "text": "\u0000"
    },
    {
     "text": "\u0001"
    },
    {
     "text": "\t"
    },
    {
     "text": " "
    },
    {
     "text": "0"
    }
   ]
  },
  {
   "name": "astral_after_bmp_private_use",
   "doc": "U+1F600 sorts after U+E000 to U+FFFF; UTF-16 unit order puts it before them.",
