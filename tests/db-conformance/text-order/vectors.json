    {
     "text": "\u0080"
    },
    {
     "text": "\u07FF"
    },
    {
     "text": "\u0800"
    },
    {
     "text": "\uFFFF"
    },
    {
     "text": "\uD800\uDC00"
    }
   ]
  },
  {
   "name": "astral_inside_text",
   "doc": "The difference sits after an equal prefix: x U+FF01 before x U+1F600.",
   "sorted": [
    {
     "text": "x\uFF01y"
    },
    {
     "text": "x\uD83D\uDE00"
    },
    {
     "text": "x\uD83D\uDE00a"
    }
   ]
  }
 ],
