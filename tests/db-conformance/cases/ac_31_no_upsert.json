  {
   "name": "ac_31_conflict_rolls_back_whole_transaction",
   "doc": "A conflicting insert after a valid one fails the transaction; the valid insert is rolled back and its id stays free.",
   "steps": [
    {
     "tx": [
      {
       "insert": {
        "model": 0,
        "row": "1",
        "fields": {
         "0": {
          "text": "a"
         }
        }
       }
      }
     ],
     "expect": "ok"
    },
    {
     "tx": [
      {
       "insert": {
        "model": 0,
        "row": "2",
        "fields": {
         "0": {
          "text": "b"
         }
        }
       }
      },
      {
       "insert": {
        "model": 1,
        "row": "1",
        "fields": {
         "0": {
          "text": "b"
         }
        }
       }
      }
     ],
     "expect": {
      "error": "Conflict"
     }
    },
    {
     "query": {
      "model": 0,
      "order": [],
      "limit": null
     },
     "expect": [
      {
       "id": "1",
       "version": 1,
       "fields": {
        "0": {
         "text": "a"
        }
       }
      }
     ]
    },
    {
     "query": {
      "model": 1,
      "order": [],
      "limit": null
     },
     "expect": []
    },
    {
     "tx": [
      {
       "insert": {
        "model": 0,
        "row": "2",
        "fields": {
         "0": {
          "text": "b"
         }
        }
       }
      }
     ],
     "expect": "ok"
    },
    {
     "query": {
      "model": 0,
      "order": [],
      "limit": null
     },
     "expect": [
      {
       "id": "1",
       "version": 1,
       "fields": {
        "0": {
         "text": "a"
        }
       }
      },
      {
       "id": "2",
       "version": 1,
       "fields": {
        "0": {
         "text": "b"
        }
       }
      }
     ]
    }
   ]
