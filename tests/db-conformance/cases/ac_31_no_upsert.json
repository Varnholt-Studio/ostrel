  {
   "name": "ac_31_insert_existing_id_same_model",
   "doc": "Insert of an id that exists in the same model fails; the existing row is unchanged.",
   "steps": [
    {
     "tx": [
      {
       "insert": {
        "model": 0,
        "row": "1",
        "fields": {
         "0": {
          "text": "a"
         }
        }
       }
      }
     ],
     "expect": "ok"
    },
    {
     "tx": [
      {
       "insert": {
        "model": 0,
        "row": "1",
        "fields": {
         "0": {
          "text": "b"
         }
        }
       }
      }
     ],
     "expect": {
      "error": "Conflict"
     }
    },
    {
     "query": {
      "model": 0,
      "order": [],
      "limit": null
     },
     "expect": [
      {
       "id": "1",
       "version": 1,
       "fields": {
        "0": {
         "text": "a"
        }
       }
      }
     ]
    }
   ]
  },
