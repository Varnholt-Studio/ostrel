// Red #1136, D94: two equal texts of 16 MiB compared once per level of a recursion 9 900
// deep. Each comparison reads 16 MiB, so its cost in steps grows with the text length and
// the default step limit ends the program long before the recursion does.
fn double(s: Text, n: Int) -> Text
  if n == 0
    return s
  return double("{s}{s}", n - 1)

fn compare(a: Text, b: Text, n: Int) -> Int
  if n == 0
    return 0
  let r = compare(a, b, n - 1)
  if a == b
    return r + 1
  return r

fn main()
  print("start")
  print(compare(double("a", 24), double("a", 24), 9900))
