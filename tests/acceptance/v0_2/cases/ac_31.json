    {
      "name": "ac_31_make_with_fresh_id",
      "covers": "control",
      "kind": "ops",
      "verdict": "allow",
      "as": "bob",
      "given": [
        {
          "as": "bob",
          "make": "Team",
          "alias": "beta",
          "fields": {
            "name": "Beta",
            "roles": [
              [
                "$user:bob",
                "admin"
              ]
            ]
          }
        },
        {
          "as": "bob",
          "make": "Task",
          "alias": "b1",
          "fields": {
            "team": "$row:beta",
            "title": "Beta one",
            "owner": "$user:bob",
            "locked": false
          }
        },
        {
          "as": "bob",
          "make": "Task",
          "alias": "b2",
          "fields": {
            "team": "$row:beta",
            "title": "Beta two",
            "owner": "$user:bob",
            "locked": false
          }
        },
        {
          "as": "bob",
          "drop": "b2"
        }
      ],
      "steps": [
        {
          "send": {
            "v": 0,
            "t": "ops",
            "ops": [
              {
                "id": "$op",
                "hlc": "$hlc",
                "model": "Task",
                "row": "$newrow:b3",
                "body": {
                  "make": {
                    "team": "$row:beta",
                    "title": "Again",
                    "owner": "$user:bob",
                    "locked": false
                  }
                }
              }
            ]
          },
          "expect": [
            {
              "ack": "$op"
            }
          ]
        }
      ],
      "db": {
        "expect": "one new Task b3"
      }
    },
