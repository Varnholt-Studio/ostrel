app Chat
  (auth paseto open)
data Room
  (field name Text)
  (field members Set[User] (= (set me)))
  (check (in (. name len) (.. 1 40)))
  (see signed)
  (make (== members (set me)))
  (edit members (or (== added (set me)) (== removed (set me))))
data Message
  (field room Room)
  (field text Text)
  (check (in (. text len) (.. 1 2000)))
  (see (in me (. room members)))
  (make (in me (. room members)))
var current: Room?
view Main
  <split>
    <col>
      for r (query Room (sort name))
        <button (. r name) (selected: (== r current)) (on click (= current r))>
      <entry (hint: (str "New room")) (submit: (str "Create"))>
        (on submit (= current (make Room (name it))))
      <text (. sync state) (look: muted)>
    <col>
      if let r current
        <row>
          <text (. r name) (look: title)>
          if (in me (. r members))
            <button (str "Leave") (on click (call (. (. r members) remove) me))>
          else
            <button (str "Join") (on click (call (. (. r members) add) me))>
        <col (scroll: end)>
          for m (query Message (where (== room r)) (sort made) (last 200))
            <row (~mine (== (. m author) me))>
              <text (. (. m author) handle) (look: strong)>
              <text (. m text)>
              <text (. (. m made) clock) (look: muted)>
        if (in me (. r members))
          <entry (hint: (str "Message")) (submit: (str "Send"))>
            (on submit (make Message (room r) (text it)))
      else
        <text (str "Pick or create a room") (look: muted)>
style 1273..1339
