// AC-33 (d): `??` turns only `Offline` into its fallback. A `Denied` answer of a server
// function stays an error unless the program names it with `catch Denied`.

app Shop
  auth paseto open

data Coupon
  code: Text
  percent: Int
  check code.len in 1..20
  check percent in 1..90
  see if signed
  make if signed

server fn discount(c: Coupon) -> Int
  call if c.author == me
  c.percent

var shown = -1

fn loadPlain(c: Coupon)
  shown = discount(c) ?? 0

fn loadNamed(c: Coupon)
  shown = discount(c) catch Denied ?? 0

view Main
  col
    for c in Coupon sort code
      row
        text c.code
        button "Plain" on click loadPlain(c)
        button "Named" on click loadNamed(c)
    text "shown {shown}"
