// Euclid's algorithm by recursion over %, and lcm built on it.

fn gcd(a: Int, b: Int) -> Int
  if b == 0
    return a
  return gcd(b, a % b)

fn lcm(a: Int, b: Int) -> Int
  return a / gcd(a, b) * b

fn main()
  print(gcd(1071, 462))
  print(gcd(48, 18))
  print(gcd(17, 5))
  print(lcm(4, 6))
  print(lcm(21, 6))
